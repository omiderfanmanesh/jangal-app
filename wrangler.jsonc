{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jangal-app",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "c6150e19-edba-44ea-b282-22c85c9b8e8e","database_name": "jangal-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "e9ac8f6dd9064efbbcdd23b3bb8bf5eb" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
